// 全局设置:后台服务(守护进程)+ Wine 目录(prefix)+ 环境检查。

import { ScrollView } from "std-widgets.slint";
import { Tokens } from "../theme.slint";
import { Divider, RevealItem } from "../widgets/base.slint";
import { ConfigInfo, DebugPanelItem, EnvCheckRow, WineInfo } from "../types.slint";
import { PathField } from "../widgets/path-field.slint";
import { AccentButton, StdButton } from "../widgets/buttons.slint";
import { CardRow, Group, SectionTitle } from "../widgets/card.slint";

export component SettingsPage inherits ScrollView {
    // 见 `games.slint` 里的长注释:fluent 默认关掉拖拽滚动,没有滚轮的机器要靠这一行。
    mouse-drag-pan-enabled: true;
    in-out property <bool> revealed: false;

    // ── 后台服务(守护进程) ──────────────────────────────────────────────
    // 措辞由 Rust 拼(`render/settings.rs` 的 `service_state`):页面只管显示。
    in property <string> service-status: "";
    in property <int> service-state: 0;          // 0 检测中 / 1 运行中 / 2 未运行
    in property <bool> service-running: false;
    in property <bool> service-busy: false;
    in property <string> service-message: "";
    in property <bool> service-message-ok: true;
    in property <string> service-hint: "";

    // ── Wine ──────────────────────────────────────────────────────────────
    // ⚠ 整块在 Windows 上不显示(见下面 `if !root.is-windows`):那边没有 wine,
    //    这几个框摆在那儿只会让人以为填错了什么(用户 2026-09-18:「wine 目录多余」)。
    in property <bool> is-windows: false;
    in-out property <string> wine-prefix: "";
    in property <WineInfo> wine;
    // 「浏览…」:系统里有没有可用的文件对话框(没有就灰掉按钮),以及没有时的理由。
    in property <bool> browse-enabled: true;
    in property <string> path-hint: "";

    // ── 配置文件 ──────────────────────────────────────────────────────────
    // 只有两个地点(用户 2026-09-19):二进制同目录(便携)/ 平台默认目录,启动时
    // 便携优先。两处都有时用户分不清哪份在生效,这一组就是把那件事摆到明面上,
    // 并且允许换 —— 换完**不用重启**(daemon 是唯一写者,它记住新路径)。
    in property <ConfigInfo> config;

    // ── 环境检查 ──────────────────────────────────────────────────────────
    // 结果由 daemon 探(`env.report` → `crate::platform`);这一页只显示,
    // 措辞与颜色码都在 Rust 那边算好(见 `render/settings.rs`)。
    in property <[EnvCheckRow]> env-checks: [];
    in property <string> env-summary: "";
    in property <string> env-distro: "";
    in property <bool> env-loaded: false;
    in property <bool> env-ok: true;

    // ── 调试面板（只有 `debug-panels` 构建里才可能是 true，见 `src/ui/debug.rs`）──
    // ⚠ 这一块**永远在树里**（不赌 Slint 有没有条件编译）：`feature` 关掉时 Rust 每帧
    //    推下来的 `debug-visible` 恒为 false，于是下面两个 `if` 都不成立 —— 用户看不到
    //    它，也点不到它。清单与标签都由 Rust 给（按钮上的字与它激活的那件事必须同源）。
    in property <bool> debug-visible: false;
    in property <[DebugPanelItem]> debug-panels: [];

    callback service-start();
    callback service-stop();
    callback wine-prefix-changed(string);
    callback browse-wine-prefix();
    callback save-wine-prefix();
    callback clear-wine-prefix();
    callback env-reload();
    // true = 切到便携那份。
    callback config-source-picked(bool);
    /// 按下调试面板里第几颗按钮（下标 → `debug::DebugPanel`，映射在 `wire.rs`）。
    callback debug-activate(int);

    Timer { interval: 40ms; running: true; triggered => { root.revealed = true; } }

    VerticalLayout {
        padding-left: root.revealed ? 28px : 68px;
        animate padding-left { duration: 260ms; easing: ease-out; }
        padding-right: 28px;
        padding-top: 12px;
        padding-bottom: 32px;
        spacing: 0px;

        RevealItem {
            revealed: root.revealed;
            step: 0;
            bottom: 20px;
            VerticalLayout {
                spacing: 4px;
                Text { text: "设置"; font-size: 28px; font-weight: 600; color: Tokens.text; }
                Text {
                    text: "后台服务、启动环境与配置文件位置。";
                    font-size: 14px;
                    color: Tokens.text-3;
                }
            }
        }

        // ── 后台服务 ──────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 1;
            bottom: 8px;
            SectionTitle { text: "后台服务"; }
        }
        RevealItem {
            revealed: root.revealed;
            step: 2;
            bottom: 24px;
            Group {
                CardRow {
                    title: "守护进程";
                    description: "游戏启动、缩放与存档同步都由它执行。";
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        Text {
                            text: root.service-status;
                            font-size: 13px;
                            color: root.service-state == 1
                                ? Tokens.ok
                                : (root.service-state == 2 ? Tokens.text-3 : Tokens.text-3);
                            vertical-alignment: center;
                            min-width: 96px;
                        }
                        AccentButton {
                            label: "启动服务";
                            button-width: 92px;
                            button-enabled: !root.service-running && !root.service-busy;
                            clicked => { root.service-start(); }
                        }
                        StdButton {
                            label: "停止服务";
                            button-width: 92px;
                            button-enabled: root.service-running && !root.service-busy;
                            clicked => { root.service-stop(); }
                        }
                    }
                }
                if root.service-message != "" : VerticalLayout {
                    Divider { }
                    VerticalLayout {
                        padding: 12px;
                        Text {
                            text: root.service-message;
                            font-size: 12px;
                            color: root.service-message-ok ? Tokens.ok : Tokens.danger;
                            wrap: word-wrap;
                        }
                    }
                }
                Divider { }
                VerticalLayout {
                    padding: 16px;
                    Text {
                        text: root.service-hint;
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ── Wine ──────────────────────────────────────────────────────────
        // 两块都带 `if`:Windows 上整节消失。分成两个 `if` 而不是包一层容器,是因为
        // 外层是 `VerticalLayout` —— 多包一层就得再对齐一次间距,不值得。
        if !root.is-windows : RevealItem {
            revealed: root.revealed;
            step: 3;
            bottom: 8px;
            SectionTitle { text: "Wine 目录（prefix）"; }
        }
        if !root.is-windows : RevealItem {
            revealed: root.revealed;
            step: 4;
            bottom: 24px;
            Group {
                CardRow {
                    title: "prefix 路径";
                    description: "启动游戏时用的 wine prefix。留空会自动探测：游戏目录内的可携式 prefix → 常见位置 → ~/.wine。";
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        PathField {
                            field-width: 300px;
                            text <=> root.wine-prefix;
                            edited(text) => { root.wine-prefix-changed(text); }
                            browse-enabled: root.browse-enabled;
                            browse-clicked => { root.browse-wine-prefix(); }
                            placeholder: "留空即自动探测";
                        }
                        AccentButton {
                            label: "保存";
                            button-width: 68px;
                            clicked => { root.save-wine-prefix(); }
                        }
                        StdButton {
                            label: "自动";
                            button-width: 68px;
                            clicked => { root.clear-wine-prefix(); }
                        }
                    }
                }
                if root.path-hint != "" : VerticalLayout {
                    Divider { }
                    VerticalLayout {
                        padding: 12px;
                        Text {
                            text: root.path-hint;
                            font-size: 11px;
                            color: Tokens.text-3;
                            wrap: word-wrap;
                        }
                    }
                }
                if root.wine.message != "" : VerticalLayout {
                    Divider { }
                    VerticalLayout {
                        padding: 12px;
                        Text {
                            text: root.wine.message;
                            font-size: 12px;
                            color: root.wine.message-ok ? Tokens.ok : Tokens.danger;
                            wrap: word-wrap;
                        }
                    }
                }
                Divider { }
                VerticalLayout {
                    padding: 16px;
                    spacing: 3px;
                    Text { text: "当前生效：" + root.wine.effective; font-size: 12px; color: Tokens.text-3; wrap: word-wrap; }
                    Text { text: "默认位置：" + root.wine.default-prefix; font-size: 11px; color: Tokens.text-3; wrap: word-wrap; }
                    Text { text: "WINEPREFIX 环境变量：" + root.wine.environment; font-size: 11px; color: Tokens.text-3; wrap: word-wrap; }
                    Text {
                        text: root.wine.detected.length == 0 ? "没有在常见位置发现 wine prefix" : "自动探测到的 prefix:";
                        font-size: 11px;
                        color: Tokens.text-3;
                    }
                    for prefix in root.wine.detected : Text {
                        text: "· " + prefix;
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ── 配置文件 ──────────────────────────────────────────────────────
        RevealItem {
            revealed: root.revealed;
            step: 5;
            bottom: 8px;
            SectionTitle { text: "配置文件"; }
        }
        RevealItem {
            revealed: root.revealed;
            step: 5;
            bottom: 24px;
            Group {
                CardRow {
                    interactive: false;
                    title: "配置放在哪";
                    description: root.config.label + " · " + root.config.path;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        StdButton {
                            label: "切到便携配置";
                            button-width: 118px;
                            // 不能点只有两种原因:已经在这儿了,或者路径被环境变量钉死
                            // (那时按钮灰着,下面那行小字说明为什么)。
                            button-enabled: root.config.can-switch && !root.config.is-portable && !root.config.busy;
                            clicked => { root.config-source-picked(true); }
                        }
                        StdButton {
                            label: "切到默认配置";
                            button-width: 118px;
                            button-enabled: root.config.can-switch && root.config.is-portable && !root.config.busy;
                            clicked => { root.config-source-picked(false); }
                        }
                    }
                }
                if root.config.message != "" : VerticalLayout {
                    Divider { }
                    VerticalLayout {
                        padding: 12px;
                        Text {
                            text: root.config.message;
                            font-size: 12px;
                            color: root.config.message-ok ? Tokens.ok : Tokens.danger;
                            wrap: word-wrap;
                        }
                    }
                }
                Divider { }
                VerticalLayout {
                    padding: 16px;
                    Text {
                        text: "便携配置写在 Kotori 程序旁边，整个目录拷到别的机器就能用。两处都有配置时以便携为准。切换会把当前配置写过去，原来那份改名成 .portable-bak，不删。";
                        font-size: 11px;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ── 环境检查 ──────────────────────────────────────────────────────
        // ⚠ 这一组**只报告、不修改**:探测跑的是 `--version` 这类只读动作,
        // 不会替你装东西、也不会搬你的凭据(见 `src/platform/mod.rs` 的文件头)。
        RevealItem {
            revealed: root.revealed;
            step: 6;
            bottom: 8px;
            SectionTitle { text: "环境检查"; }
        }
        RevealItem {
            revealed: root.revealed;
            step: 6;
            bottom: 24px;
            Group {
                CardRow {
                    interactive: false;
                    title: "依赖";
                    description: root.env-loaded
                        ? root.env-summary
                        : "启动游戏、缩放与云同步要用到的外部程序。缺了必需项就没法启动，可选的那种会退化成写在命令行里的样子。";
                    description-color: !root.env-loaded
                        ? Tokens.text-3
                        : (root.env-ok ? Tokens.ok : Tokens.danger);
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        StdButton {
                            label: "重新检查";
                            button-width: 82px;
                            button-enabled: root.env-loaded;
                            clicked => { root.env-reload(); }
                        }
                    }
                }
                if root.env-distro != "" : VerticalLayout {
                    Divider { }
                    VerticalLayout {
                        padding: 12px;
                        Text { text: root.env-distro; font-size: 11px; color: Tokens.text-3; }
                    }
                }
                if root.env-checks.length == 0 : VerticalLayout {
                    Divider { }
                    VerticalLayout {
                        padding: 16px;
                        Text {
                            text: "还没有检查结果。守护进程连上之后点「重新检查」。";
                            font-size: 11px;
                            color: Tokens.text-3;
                            wrap: word-wrap;
                        }
                    }
                }
                for check in root.env-checks : VerticalLayout {
                    Divider { }
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: check.title;
                                font-size: 13px;
                                color: Tokens.text;
                                min-width: 120px;
                            }
                            Text {
                                text: check.state-label;
                                font-size: 12px;
                                color: check.state == 0
                                    ? Tokens.ok
                                    : (check.state == 1 ? Tokens.warn : Tokens.danger);
                                min-width: 44px;
                            }
                            Text {
                                text: check.detail;
                                font-size: 11px;
                                color: Tokens.text-3;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                        if check.impact != "" : Text {
                            text: check.impact;
                            font-size: 11px;
                            color: Tokens.text-3;
                            wrap: word-wrap;
                        }
                        if check.install != "" : Text {
                            text: "装它：" + check.install;
                            font-size: 11px;
                            color: Tokens.accent;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // ── 调试面板 ──────────────────────────────────────────────────────
        // **只在 `debug-panels` 构建里出现**（CI 的 Linux 交付产物开着它，见
        // `.github/workflows/ci.yml` 与 `src/ui/debug.rs`）。两块都带 `if`：标签与
        // 可见性都由 Rust 推下来，feature 关掉时 `debug-visible` 恒为 false。
        //
        // 按钮**一颗对应一个弹窗/状态**，按下去只是把假数据塞进既有状态字段 —— 弹窗与
        // 横幅仍然是既有那些组件画出来的，这里没有、也不许有调试专用的弹窗。
        if root.debug-visible : RevealItem {
            revealed: root.revealed;
            step: 7;
            bottom: 8px;
            SectionTitle { text: "调试"; }
        }
        if root.debug-visible : RevealItem {
            revealed: root.revealed;
            step: 7;
            bottom: 24px;
            Group {
                CardRow {
                    interactive: false;
                    title: "强制激活弹窗与横幅";
                    description: "假数据 + 原生渲染路径：这些按钮把假数据塞进既有的状态字段，弹窗与横幅还是既有代码画出来的。弹窗里的确认按钮在这一态下**不发任何请求**。这一块只存在于开了 debug-panels 的构建里。";
                }
                for panel in root.debug-panels : VerticalLayout {
                    Divider { }
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        StdButton {
                            label: panel.label;
                            // ⚠ 宽度必须**写死**：这一页的根是 `ScrollView`，拿
                            // `parent.width`（或任何跟着布局走的宽度）会让
                            // `button-width → layoutinfo-h → min-width → viewport-width`
                            // 绕成一个绑定环，Slint 直接在编译期把整个 `app.slint` 拒掉。
                            // 380px 装得下最长的那个标签（见 `debug::DebugPanel::ALL`）。
                            button-width: 380px;
                            clicked => { root.debug-activate(panel.index); }
                        }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; background: #00000000; }
    }
}
